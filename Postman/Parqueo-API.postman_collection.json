    "_postman_id": "a250acf9-df77-5944-a32f-2279fe1359d8",
    "name": "Parqueo API — Trabajo en Clase 03",
    "description": "Pruebas del API de Parqueo (BSI-19 Programación Avanzada). Ejecute las carpetas en orden: cada POST guarda el id creado en una variable de colección que usan el GET, PUT y DELETE siguientes, y al final el registro se borra (los datos quedan como estaban). El encabezado X-Origen-Datos de cada respuesta indica si respondió el origen Json o BaseDatos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Automóviles",
      "item": [
        {
          "name": "GET listado de automóviles (página 1, 10 por página)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Origen de datos: ' + pm.response.headers.get('X-Origen-Datos'), () => pm.expect(['Json','BaseDatos']).to.include(pm.response.headers.get('X-Origen-Datos')));",
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Resultado esperado: [1, 2, 3, 4, 5, 6]', () => pm.expect(pm.response.json().map(x => x.id)).to.eql([1, 2, 3, 4, 5, 6]));",
                  "pm.test('Los listados no anidan ingresos', () => pm.expect(pm.response.json()[0]).to.not.have.property('ingresos'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/automoviles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "automoviles"
              ]
            }
          }
        },
        {
          "name": "GET listado paginado (página 2, tamaño 4)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
