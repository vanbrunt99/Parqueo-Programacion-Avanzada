        {
          "name": "GET automóvil por id con navegación (id 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Origen de datos: ' + pm.response.headers.get('X-Origen-Datos'), () => pm.expect(['Json','BaseDatos']).to.include(pm.response.headers.get('X-Origen-Datos')));",
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "const a = pm.response.json();",
                  "pm.test('Datos del automóvil', () => { pm.expect(a.fabricante).to.eql('Toyota'); pm.expect(a.tipo).to.eql('sedán'); });",
                  "pm.test('Navegación: 3 ingresos con su parqueo', () => { pm.expect(a.ingresos.map(i => i.consecutivo)).to.eql([1, 8, 13]); a.ingresos.forEach(i => pm.expect(i.parqueo.nombre).to.be.a('string')); });",
                  "pm.test('Campos calculados del ingreso 1', () => { const i = a.ingresos[0]; pm.expect(i.duracionEstadiaMinutos).to.eql(150); pm.expect(i.duracionEstadiaHoras).to.eql(2.5); pm.expect(i.montoTotalAPagar).to.eql(3125); });",
                  "pm.test('Sin referencia circular (el ingreso no repite el automóvil)', () => pm.expect(a.ingresos[0]).to.not.have.property('automovil'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/automoviles/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
