                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Resultado esperado: [5, 6]', () => pm.expect(pm.response.json().map(x => x.id)).to.eql([5, 6]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/automoviles?pagina=2&tamanoPagina=4",
