<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Mismo secreto que Parqueo.AppConsole: la cadena ConnectionStrings:ParqueoDb se configura una sola vez. -->
    <UserSecretsId>99f7960e-6480-4a43-b911-104b6ecd8154</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Parqueo.BusinessLogic\Parqueo.BusinessLogic.csproj" />
  </ItemGroup>

  <!-- Copia de trabajo de los JSON junto al ejecutable: el API nunca modifica la carpeta Datos/ del repositorio. -->
  <ItemGroup>
    <None Include="..\Datos\*.json" Link="Datos\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
