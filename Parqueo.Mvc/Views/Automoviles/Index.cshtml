@model AutomovilesIndexViewModel
@{
    ViewData["Title"] = "Automóviles";
    string volver = Context.Request.Path + Context.Request.QueryString;
    var filtro = new Dictionary<string, string>();
    if (Model.AnioDesde is int desde) { filtro["anioDesde"] = desde.ToString(System.Globalization.CultureInfo.InvariantCulture); }
    if (Model.AnioHasta is int hasta) { filtro["anioHasta"] = hasta.ToString(System.Globalization.CultureInfo.InvariantCulture); }
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Automóviles</h1>
    <a class="btn btn-success" asp-action="Crear" asp-route-volver="@volver">Crear automóvil</a>
</div>

<form id="filtro-anios" method="get" asp-action="Index" class="card card-body mb-3" novalidate>
    <fieldset>
        <legend class="h6">Filtrar por intervalo de años (ambos años incluidos)</legend>
        <div class="row g-3 align-items-end">
            <div class="col-sm-4 col-md-3">
                <label for="anioDesde" class="form-label">Año inferior</label>
                <input id="anioDesde" name="anioDesde" type="number" inputmode="numeric" min="@AutomovilesIndexViewModel.AnioMinimo" max="@AutomovilesIndexViewModel.AnioMaximo"
                       class="form-control" value="@(Model.AnioDesde?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? Context.Request.Query["anioDesde"].ToString())" placeholder="Ej. 2015" />
            </div>
            <div class="col-sm-4 col-md-3">
                <label for="anioHasta" class="form-label">Año superior</label>
                <input id="anioHasta" name="anioHasta" type="number" inputmode="numeric" min="@AutomovilesIndexViewModel.AnioMinimo" max="@AutomovilesIndexViewModel.AnioMaximo"
                       class="form-control" value="@(Model.AnioHasta?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? Context.Request.Query["anioHasta"].ToString())" placeholder="Ej. 2019" />
            </div>
            <div class="col-sm-4 col-md-6 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Consultar</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Limpiar filtro</a>
            </div>
        </div>
        <p class="form-text mb-0">Deje un año vacío para no limitar ese extremo; sin años se listan todos los automóviles.</p>
    </fieldset>
</form>

<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

@if (Model.Resultado is { } resultado)
{
    if (resultado.Total == 0)
    {
        <div class="alert alert-info" role="status" id="sin-resultados">
            No hay automóviles @(Model.HayFiltro ? "en el intervalo indicado" : "registrados").
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle tabla-datos" id="tabla-automoviles">
                <caption class="visually-hidden">Automóviles @(Model.HayFiltro ? "filtrados por año" : "")</caption>
                <thead>
                    <tr>
                        <th scope="col" class="numero">Id</th>
                        <th scope="col">Color</th>
                        <th scope="col" class="numero">Año</th>
                        <th scope="col">Fabricante</th>
                        <th scope="col">Tipo</th>
                        <th scope="col"><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var automovil in resultado.Registros)
                    {
                        <tr data-id="@automovil.Id">
                            <td class="numero">@automovil.Id</td>
                            <td>@automovil.Color</td>
                            <td class="numero">@automovil.Anio</td>
                            <td>@automovil.Fabricante</td>
                            <td>@TiposAutomovil.Etiqueta(automovil.Tipo)</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Detalles" asp-route-id="@automovil.Id" asp-route-volver="@volver">Detalles</a>
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@automovil.Id" asp-route-volver="@volver">Editar</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Borrar" asp-route-id="@automovil.Id" asp-route-volver="@volver">Borrar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <partial name="_Paginacion" model="@(new PaginacionViewModel("Automoviles", resultado.Pagina, resultado.TotalPaginas, resultado.Desde, resultado.Hasta, resultado.Total, Model.TamanoPagina, "automóviles", filtro))" />
}
