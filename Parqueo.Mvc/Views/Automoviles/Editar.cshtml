@model AutomovilFormularioViewModel
@{
    ViewData["Title"] = $"Editar automóvil #{Model.Id}";
}
<h1 class="h3">Editar automóvil #@Model.Id</h1>
<p class="text-muted">Al guardar se envía <code>PUT /api/automoviles/@Model.Id</code>: se actualiza este registro, no se crea otro.</p>
<form asp-action="Editar" asp-route-id="@Model.Id" method="post" class="card card-body">
    <input type="hidden" name="volver" value="@ViewData["Volver"]" />
    <partial name="_Formulario" model="Model" />
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a class="btn btn-outline-secondary" asp-action="Detalles" asp-route-id="@Model.Id" asp-route-volver="@ViewData["Volver"]">Cancelar</a>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
